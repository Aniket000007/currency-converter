# Copy to converter/.env and fill in. Never commit the real .env.

# Redis (L2 rate cache)
SPRING_REDIS_HOST=localhost
SPRING_REDIS_PORT=6379
SPRING_REDIS_PASSWORD=
SPRING_REDIS_SSL=false

# Folder containing eng.traineddata
# macOS (Homebrew): /opt/homebrew/share/tessdata
# Docker image:     /usr/share/tessdata
TESSERACT_PATH=/opt/homebrew/share/tessdata

# Optional, defaults to 8080
# PORT=8080
